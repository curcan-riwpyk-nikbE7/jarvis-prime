# Ключ от Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Модель по умолчанию
GEMINI_MODEL=gemini-3.8-flash

# Голос Джарвиса (ru-RU-DmitryNeural / ru-RU-SvetlanaNeural / en-GB-RyanNeural)
JARVIS_VOICE=ru-RU-DmitryNeural

# Режим ввода по умолчанию: voice (голос) или text (текстовый терминал)
DEFAULT_INPUT_MODE=voice
